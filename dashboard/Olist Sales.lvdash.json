{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "KPI totals",
      "queryLines": [
        "SELECT SUM(price)                  AS revenue,\n",
        "       COUNT(DISTINCT order_id)    AS orders,\n",
        "       COUNT(DISTINCT customer_id) AS customers\n",
        "FROM olist.gold.fact_orders\n"
      ]
    },
    {
      "name": "revenue_by_month",
      "displayName": "Revenue by month",
      "queryLines": [
        "SELECT d.month_start, SUM(f.price) AS revenue\n",
        "FROM olist.gold.fact_orders f\n",
        "JOIN olist.gold.dim_date d ON f.order_date = d.order_date\n",
        "GROUP BY d.month_start\n",
        "ORDER BY d.month_start\n"
      ]
    },
    {
      "name": "top_categories",
      "displayName": "Top 10 product categories",
      "queryLines": [
        "SELECT p.product_category, SUM(f.price) AS revenue\n",
        "FROM olist.gold.fact_orders f\n",
        "JOIN olist.gold.dim_product p ON f.product_id = p.product_id\n",
        "GROUP BY p.product_category\n",
        "ORDER BY revenue DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "orders_by_state",
      "displayName": "Orders by state",
      "queryLines": [
        "SELECT c.customer_state, COUNT(DISTINCT f.order_id) AS orders\n",
        "FROM olist.gold.fact_orders f\n",
        "JOIN olist.gold.dim_customer c ON f.customer_id = c.customer_id\n",
        "GROUP BY c.customer_state\n",
        "ORDER BY orders DESC\n"
      ]
    },
    {
      "name": "payment_types",
      "displayName": "Payment type split",
      "queryLines": [
        "SELECT payment_type, SUM(payment_value) AS total_paid\n",
        "FROM olist.gold.payments\n",
        "GROUP BY payment_type\n"
      ]
    },
    {
      "name": "delivery_days",
      "displayName": "Delivery days by month",
      "queryLines": [
        "SELECT d.month_start, AVG(f.delivery_days) AS avg_delivery_days\n",
        "FROM olist.gold.fact_orders f\n",
        "JOIN olist.gold.dim_date d ON f.order_date = d.order_date\n",
        "GROUP BY d.month_start\n",
        "ORDER BY d.month_start\n"
      ]
    }
  ],
